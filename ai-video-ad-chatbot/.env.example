STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# Redis (for BullMQ, once the real queue is wired up)
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=1
